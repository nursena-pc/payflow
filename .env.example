# Copy this file to .env for local development.
# Never commit the real .env file.

DB_URL=jdbc:postgresql://localhost:5432/payflow
DB_USERNAME=payflow
DB_PASSWORD=payflow
DB_MAX_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=payflow

SERVER_PORT=8080

JWT_KEY_PROVIDER_MODE=ephemeral
JWT_ACTIVE_KEY_ID=local-development
JWT_ACTIVE_PRIVATE_KEY_LOCATION=
JWT_ACTIVE_PUBLIC_KEY_LOCATION=
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY_LOCATION=

ACCOUNT_ACTION_EMAIL_VERIFICATION_TTL=24h
ACCOUNT_ACTION_EMAIL_VERIFICATION_CONFIRMATION_URI=https://app.payflow.local/verify-email
ACCOUNT_ACTION_PASSWORD_RECOVERY_CONFIRMATION_URI=https://app.payflow.local/recover-password
ACCOUNT_ACTION_PASSWORD_RECOVERY_TTL=30m

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
MAIL_CONTENT_PROTECTION_MODE=ephemeral
MAIL_CONTENT_ENCRYPTION_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLED=false
MAIL_FROM_ADDRESS=no-reply@payflow.local
MAIL_FROM_NAME=PayFlow
MAIL_OUTBOX_POLLING_ENABLED=false
MAIL_OUTBOX_WORKER_ID=payflow-mail-local
MAIL_OUTBOX_POLLING_BATCH_SIZE=50
MAIL_OUTBOX_POLLING_LEASE_DURATION=30s
MAIL_OUTBOX_POLLING_FIXED_DELAY=2s
MAIL_OUTBOX_POLLING_INITIAL_DELAY=5s
MAIL_OUTBOX_RETRY_MAX_ATTEMPTS=5
MAIL_OUTBOX_RETRY_INITIAL_DELAY=30s
MAIL_OUTBOX_RETRY_MAXIMUM_DELAY=10m
